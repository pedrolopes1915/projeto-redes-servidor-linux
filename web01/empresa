# Redireciona todo http para https
server {
	listen 80;
	server_name web01.empresa.local;

	access_log /var/log/nginx/empresa.access.log;
	error_log /var/log/nginx/empresa.error.log warn;

	return 301 https://$host$request_uri;
}

# Site principal em https
server {
	listen 443 ssl;
	server_name web01.empresa.local;

	ssl_certificate /etc/nginx/ssl/web01.crt;
	ssl_certificate_key /etc/nginx/ssl/web01.key;

	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 10m;

	access_log /var/log/nginx/empresa.access.log;
	error_log /var/log/nginx/empresa.error.log warn;

	error_page 404 /erros/404.html;
	error_page 500 502 503 504 /erros/50x.html;

	location /erros/ {
		alias /var/www/errors/;
		internal;
	}

	location / {
		limit_req zone=general burst=10 nodelay;

		proxy_pass http://127.0.0.1:8000;
		proxy_intercept_errors on;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}

